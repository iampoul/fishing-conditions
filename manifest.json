{
  "schemaVersion": 1,
  "id": "io.github.iampoul.fishing-conditions",
  "name": "Fishing Conditions",
  "version": "0.2.1",
  "author": "iampoul",
  "license": "MIT",
  "description": "Simple fishing conditions: weather, wind, waves, and sunrise/sunset for a chosen location.",
  "kinds": ["service", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Fishing",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "location": null,
      "units": "metric",
      "refreshMinutes": 30,
      "windCautionKph": 25,
      "waveCautionM": 1.5
    },
    "schema": []
  }
}

